
# ========================================
# Python cache
# ========================================
__pycache__/
*.py[cod]

# ========================================
# Virtual environments
# ========================================
.venv/
venv/
env/
ENV/

# ========================================
# Jupyter temporary files
# ========================================
.ipynb_checkpoints/

# ========================================
# IDE and operating system files
# ========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ========================================
# Logs and temporary files
# ========================================
*.log
*.tmp
*.bak

# ========================================
# Large datasets
# ========================================
*.parquet
*.pkl
*.pickle

# ========================================
# Research benchmark data
# ========================================

# Ignore other raw and processed datasets
/data/raw/*
/data/processed/*

# Keep benchmark measurements
!/data/raw/test_run.jsonl
!/data/raw/method_comparison.jsonl

# Keep processed summaries
!/data/processed/metrics_summary.csv
!/data/processed/method_comparison_summary.csv

!/data/raw/observed_days.jsonl
!/data/processed/observed_seasons.csv
!/data/processed/observed_method_summary.csv
